{
  "name": "music-assistant-card",
  "private": true,
  "version": "0.4.0",
  "type": "module",
  "scripts": {
    "build": "tsc && eslint . && vite build && node scripts/copy-card.mjs && node scripts/verify-artifact.mjs",
    "check": "tsc --noEmit",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "eslint": "^10.8.1",
    "eslint-config-prettier": "^10.1.8",
    "jsdom": "^29.1.1",
    "prettier": "^3.9.6",
    "typescript": "~6.0.2",
    "typescript-eslint": "^8.66.0",
    "vite": "^8.2.0",
    "vitest": "^4.1.10"
  },
  "dependencies": {
    "lit-html": "^3.3.3",
    "swiper": "^14.1.0"
  }
}
